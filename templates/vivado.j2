# === Arquivos ===
{% for f in files %}
{% set ext = f.split('.')[-1].lower() %}
{% if ext == "sv" -%}
read_verilog -sv {{ f }}
{% elif ext == "v" -%}
read_verilog {{ f }}
{% elif ext in ["vhdl", "vhd"] -%}
read_vhdl -vhdl2008 {{ f }}
{% else -%}
# Arquivo não reconhecido: {{ f }}
{% endif %}
{% endfor %}

# include dirs

{% if include_dirs %}
set_property include_dirs [list {{ include_dirs | join(' ') }} ] [get_filesets sources_1]
{% endif %}

# Constraints
# RV-Bench local patch: the metrics variant builds the core's own top; the
# board's pin constraints target fpga_top's ports and a board clock port, none
# of which exist in a bare core, so reading them there is noise (and, with no
# clock on the core's own clock pin, place_design then fails with
# [Place 30-188] "UnBuffered IOs"). Only the hardware variant, whose top is
# fpga_top, reads them.
{% if bitstream %}
read_xdc "{{ constraints }}"
set_property PROCESSING_ORDER EARLY [get_files {{ constraints }}]
{% else %}
# (metrics: no board XDC -- see below)
{% endif %}

# Synthesis
# RV-Bench local patch: the metrics variant's core top has no board pin
# constraints and, for a wide interface, more ports than the device has pins
# -- in-context opt_design/place_design then fail with [Place 30-415] /
# [Place 30-58] "IO Placement failed due to overutilization", even though the
# metric it exists to collect is logic utilisation and timing. Build it
# out-of-context there: that skips IO buffer insertion and IO placement
# outright, so P&R only has to place the core's own logic. The hardware
# variant keeps the normal in-context flow (fpga_top is pin-constrained, and
# there the bitstream really is the point).
{% if bitstream %}synth_design -top "{{ top_module }}" -part "{{ fpga_part }}"
{% else %}synth_design -top "{{ top_module }}" -part "{{ fpga_part }}" -mode out_of_context
# Out-of-context synthesis inserts no clock buffer, so constrain whatever
# clock-looking input port(s) the core exposes itself, purely so the placer
# has a clock to time against; cores with no such port still report
# utilisation.
foreach clk [get_ports -quiet -filter {DIRECTION == IN && (name =~ "*clk*" || name =~ "*clock*" || name =~ "*CLK*" || name =~ "*CLOCK*")}] {
    create_clock -name $clk -period 10.0 $clk
}
{% endif %}

# Place and Route
opt_design
place_design

# Reports após placement
report_utilization -hierarchical -file reports/{{ prefix }}_utilization.xml -format xml
report_utilization -hierarchical -file reports/{{ prefix }}_utilization_hierarchical_place.rpt
report_utilization               -file reports/{{ prefix }}_utilization_place.rpt
report_io                        -file reports/{{ prefix }}_io.rpt
report_control_sets -verbose     -file reports/{{ prefix }}_control_sets.rpt
report_clock_utilization         -file reports/{{ prefix }}_clock_utilization.rpt

# Routing
route_design

# Reports após routing
report_timing_summary -no_header -no_detailed_paths
report_route_status                 -file reports/{{ prefix }}_route_status.rpt
report_drc                          -file reports/{{ prefix }}_drc.rpt
report_timing_summary -max_paths 10 -file reports/{{ prefix }}_timing.rpt
report_power                        -file reports/{{ prefix }}_power.rpt
report_timing_summary    -no_header -file reports/{{ prefix }}_timing_resumed.rpt -no_detailed_paths


# Bitstream
{% if bitstream %}
write_bitstream -force "{{ prefix }}.bit"
{% else %}
# RV-Bench local patch: metrics-only run, no bitstream. The core's own top
# has no board pin constraints, so write_bitstream would fail DRC (NSTD-1 /
# UCIO-1) for a wide interface; the utilisation and timing reports are
# already written above.
{% endif %}

exit
