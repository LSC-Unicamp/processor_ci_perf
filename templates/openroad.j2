export DESIGN_NICKNAME = {{ design_nickname }}
export DESIGN_NAME     = {{ design_name }}
export PLATFORM        = {{ platform }}

export SYNTH_HIERARCHICAL ?= {{ synth_hierarchical }}
export SYNTH_MINIMUM_KEEP_SIZE ?= {{ synth_min_keep_size }}

{% if include_dirs %}
export VERILOG_INCLUDE_DIRS = {{ include_dirs | join(' \\\n\t') }}
{% endif %}

{% if verilog_files_file %}
export VERILOG_FILES_FILE = {{ verilog_files_file }}
export VERILOG_FILES =
{% else %}
export VERILOG_FILES = {{ verilog_files | join(' \\\n\t') }}
{% endif %}
export SDC_FILE      = {{ sdc_file }}

{% if synth_slang_args or slang_diag_json or verilog_files_file %}
export SYNTH_SLANG_ARGS = {{ synth_slang_args }} {% if slang_diag_json %}--diag-json {{ slang_diag_json }} --error-limit 0{% endif %} {% if verilog_files_file %}-F $(VERILOG_FILES_FILE){% endif %}
{% endif %}

{% if additional_lefs == true %}
export ADDITIONAL_LEFS = $(PLATFORM_DIR)/{{ additional_lef_files | join(' \\\n\t$(PLATFORM_DIR)/') }}
{% endif %}

{% if additional_libs == true %}
export ADDITIONAL_LIBS = $(PLATFORM_DIR)/{{ additional_lib_files | join(' \\\n\t$(PLATFORM_DIR)/') }}
{% endif %}

export ABC_AREA           = 1
export CORE_MARGIN        = {{ core_margin }}
export MACRO_PLACE_HALO   = 3 3
export CORE_UTILIZATION   = {{ core_utilization }}
export PLACE_DENSITY      = {{ place_density }}

{% if verilog_top_params %}
export VERILOG_TOP_PARAMS = {% for name, value in verilog_top_params %}{{ name }} {{ value }} {% endfor %}
{% endif %}

export SYNTH_HDL_FRONTEND = {{ synth_hdl_frontend }}
{% if synth_mock_large_memories %}
# ORFS rejects an inferred read/write memory over SYNTH_MEMORY_MAX_BITS
# (default 4096) with no PDK macro; mock it so the flow still yields
# area/timing. A core that wants the real (flip-flop) memory sets
# `synth_memory_max_bits` instead.
export SYNTH_MOCK_LARGE_MEMORIES ?= {{ synth_mock_large_memories }}
{% endif %}
{% if synth_memory_max_bits %}
export SYNTH_MEMORY_MAX_BITS ?= {{ synth_memory_max_bits }}
{% endif %}
export TNS_END_PERCENT    = 100
