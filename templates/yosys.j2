# === Ler arquivos SystemVerilog com defer ===
# One call for every file, not one call per file: each separate
# read_systemverilog invocation is its own SystemVerilog compilation unit, so a
# macro or package that one file defines and a sibling file relies on without
# its own `include`/import (the common "flat compile" convention many of these
# repositories were written and tested against, e.g. `iverilog *.v`) was
# invisible across files -- confirmed against RV-Bench's corpus: reading all
# files together resolves it, the same effect --single-unit has in tools that
# offer that flag natively (this Surelog-based frontend does not).
yosys read_systemverilog {{ include_dirs_str }} {{ synth_synlig_args }} -defer {{ files | join(' ') }}

# Linkar todos os módulos
yosys read_systemverilog -link

# Síntese para ECP5
yosys synth_ecp5 -json {{ output_json }} -top {{ top_module }} -abc9
